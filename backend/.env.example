# Development demonstration only. No real identity, vault, or browser adapters.
THROUGH_ENV=development
THROUGH_DEMO_AUTH=true
THROUGH_ADDR=127.0.0.1:8080
THROUGH_DATABASE_URL=postgres://through:through-local-only@127.0.0.1:5432/through?sslmode=disable
THROUGH_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Optional: serve an existing Next.js static export alongside the API.
THROUGH_STATIC_DIR=../out
# Optional: minimum 32 characters; unset means /metrics is disabled.
# THROUGH_METRICS_TOKEN=generate-a-random-development-token
# Integration tests require an isolated test database; never use a customer DB.
# THROUGH_TEST_DATABASE_URL=postgres://through:through-local-only@127.0.0.1:5432/through_test?sslmode=disable
